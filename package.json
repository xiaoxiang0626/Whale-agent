{
  "name": "my-coding-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A coding agent built in small, documented pull requests.",
  "type": "module",
  "bin": {
    "my-coding-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:tui:pty": "node scripts/test-tui-pty.ts",
    "test:agent:live": "node scripts/test-agent-live.ts",
    "test:editing:live": "node scripts/test-editing-live.ts",
    "test:commands:live": "node scripts/test-commands-live.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "ink-testing-library": "4.0.0",
    "node-pty": "1.2.0-beta.18",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "diff": "9.0.0",
    "ignore": "7.0.16",
    "ink": "8.0.0",
    "react": "19.3.1",
    "string-width": "9.0.0",
    "wrap-ansi": "10.0.2"
  }
}
